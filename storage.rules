rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user has admin role via Firestore document
    // Note: Storage rules cannot directly access Firestore, so we use custom claims
    // The admin claim must be set when user role is updated in Firestore
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Case images - readable by authenticated users, writable by admins
    match /cases/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // General images - readable by authenticated users, writable by admins
    match /images/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Community images - users can upload to their own folder, all authenticated can read
    match /community/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
