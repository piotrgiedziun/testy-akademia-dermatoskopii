{
  "name": "testy-akademia-dermatoskopii",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "VITE_USE_EMULATORS=true VITE_FIREBASE_PROJECT_ID=demo-test-project VITE_FIREBASE_API_KEY=demo-api-key vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "echo '⚠️  Make sure emulators are running first: npm run emulators' && playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "emulators": "firebase emulators:start --project demo-test-project",
    "emulators:export": "firebase emulators:export ./e2e/emulator-data",
    "e2e": "start-server-and-test emulators http://localhost:4000 e2e:dev",
    "e2e:dev": "start-server-and-test dev:e2e http://localhost:5173 test:e2e",
    "seed": "tsx scripts/seed-firestore.ts",
    "seed:e2e": "tsx e2e/scripts/seed-emulator.ts",
    "clean-db": "tsx scripts/clean-firestore.ts"
  },
  "dependencies": {
    "firebase": "^10.8.0",
    "i18next": "^23.8.0",
    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-http-backend": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.22.0",
    "react-zoom-pan-pinch": "^3.4.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@playwright/test": "^1.58.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "firebase-admin": "^13.6.0",
    "globals": "^15.9.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "start-server-and-test": "^2.1.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.19.0",
    "vitest": "^1.2.0",
    "wait-on": "^9.0.3",
    "workbox-window": "^7.0.0",
    "zod": "^4.3.6"
  }
}
